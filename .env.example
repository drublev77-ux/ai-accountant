# Sentry Configuration
# Copy this file to .env.local and add your actual Sentry DSN
# Get your DSN from: Settings → Projects → [Your Project] → Client Keys (DSN)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Sentry Auth Token (for source map uploads)
# Get token from: Settings → Account → API → Auth Tokens
# Required scopes: project:releases, project:write
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Environment
VITE_ENVIRONMENT=production
